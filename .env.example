# LLM behind an OpenAI-compatible endpoint (LLMConfig in src/configs/config.py)
LLM_API_KEY=sk-
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=google/gemini-3.8-flash
# Optional; uncomment to set. An empty value is not "unset".
# null sends no temperature, for providers that reject one; default None
# LLM_TEMPERATURE=0.7
# Thinking budget sent as reasoning.max_tokens, for endpoints that accept it;
# unset, none is sent
# LLM_REASONING_MAX_TOKENS=1024
# Language of the agent's messages; default English
# AGENT_LANGUAGE=Chinese
# Vision model that reads --image files; unset, images are refused
# LLM_VISION_MODEL=google/gemini-3.8-flash
# Photo massing, both optional: TokenHub HY-3D image-to-3D, and a SAM 3
# server (scripts/sam3_segment_server.py) that cuts the building out first
# IMAGE_TO_3D_URL=https://tokenhub.tencentmaas.com/v1/api/3d
# IMAGE_TO_3D_API_KEY=
# SEGMENT_URL=http://localhost:8082

# Reference library search (src/reference/settings.py): set both URLs or
# neither; set but unreachable, the run fails before any LLM call
# REFERENCE_QDRANT_URL=http://localhost:6333
# REFERENCE_QDRANT_API_KEY=
# REFERENCE_EMBEDDING_URL=http://localhost:8000/v1
# REFERENCE_EMBEDDING_API_KEY=
# REFERENCE_EMBEDDING_MODEL = "qwen/qwen3-embedding-8b"
# REFERENCE_COLLECTION = "ep_reference_qwen3_embedding_8b"
# Optional; if used to pull or publish, set the repository name
# REFERENCE_HUB_REPO=
# Further overrides: REFERENCE_LIBRARY_PATH

# Optional LangSmith tracing and logging
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# LANGSMITH_PROJECT=
# LANGSMITH_TRACING=true
