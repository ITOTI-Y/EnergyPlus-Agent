{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MCP Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "mcp-server",
                "--transport",
                "streamable-http",
                "--host",
                "0.0.0.0",
                "--port",
                "8600"
            ]
        },
        {
            "name": "MCP + Inspector",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "mcp-server",
                "--transport",
                "streamable-http",
                "--host",
                "0.0.0.0",
                "--port",
                "8600"
            ],
            "preLaunchTask": "Start MCP Inspector"
        },
        {
            "name": "Zone Agent",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/agent/nodes/test_zone.py",
                "-v"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Export Demo Trace",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/export_trace.py",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${workspaceFolder}/tests",
                "-v",
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Reference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "reference",
                "load",
            ],
            "cwd": "${workspaceFolder}"
        },
    ],
}