{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "convert-idf"
            ]
        },
        {
            "name": "MCP Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "mcp-server", "--transport", "http", "--port", "8000"
            ]
        }
    ],
    "compounds": [
        {
            "name": "MCP + Inspector",
            "configurations": ["MCP Server"],
            "preLaunchTask": "Start MCP Inspector",
            "stopAll": true
        }
    ]
}